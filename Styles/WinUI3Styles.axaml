<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <!-- 全局默认字体（中文字体优先，Inter 作为英文字体回退） -->
            <FontFamily x:Key="DefaultFont">Microsoft YaHei, Inter, sans-serif</FontFamily>

            <!-- ===== 主题感知资源：深色/浅色自动适配 ===== -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- WinUI 3 专用颜色（浅色） -->
                    <Color x:Key="WinUI3BackgroundColor">#F2F2F2</Color>
                    <Color x:Key="WinUI3CardBackgroundColor">#FFFFFF</Color>
                    <Color x:Key="WinUI3CardBorderColor">#E0E0E0</Color>
                    <Color x:Key="WinUI3TextPrimaryColor">#000000</Color>
                    <Color x:Key="WinUI3TextSecondaryColor">#666666</Color>
                    <Color x:Key="WinUI3BorderColor">#D0D0D0</Color>
                    <Color x:Key="WinUI3TitleBarColor">#E8E8E8</Color>
                    <Color x:Key="WinUI3SelectionColor">#005FB8</Color>

                    <!-- 半透明背景资源（浅色主题） -->
                    <Color x:Key="PanelBackground">#99FFFFFF</Color>
                    <Color x:Key="InputBackground">#B3FFFFFF</Color>
                    <Color x:Key="ButtonBackground">#B3FFFFFF</Color>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!-- WinUI 3 专用颜色（深色） -->
                    <Color x:Key="WinUI3BackgroundColor">#1C1C1C</Color>
                    <Color x:Key="WinUI3CardBackgroundColor">#2C2C2C</Color>
                    <Color x:Key="WinUI3CardBorderColor">#3C3C3C</Color>
                    <Color x:Key="WinUI3TextPrimaryColor">#FFFFFF</Color>
                    <Color x:Key="WinUI3TextSecondaryColor">#999999</Color>
                    <Color x:Key="WinUI3BorderColor">#555555</Color>
                    <Color x:Key="WinUI3TitleBarColor">#2B2B2B</Color>
                    <Color x:Key="WinUI3SelectionColor">#99C4FF</Color>

                    <!-- 半透明背景资源（深色主题） -->
                    <Color x:Key="PanelBackground">#992C2C2C</Color>
                    <Color x:Key="InputBackground">#B32C2C2C</Color>
                    <Color x:Key="ButtonBackground">#B32C2C2C</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- WinUI 3 按钮样式 -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- WinUI 3 Accent 按钮 -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight1}" />
    </Style>

    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
    </Style>

    <!-- 超链接按钮 -->
    <Style Selector="Button.hyperlink">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="Button.hyperlink:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>

    <!-- WinUI 3 TextBox 样式 -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#border">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#border">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
    </Style>

    <!-- WinUI 3 ComboBox 样式 -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#border">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#border">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- WinUI 3 CheckBox 样式 -->
    <Style Selector="CheckBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#border">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
    </Style>

    <!-- WinUI 3 NumericUpDown 样式 -->
    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{DynamicResource InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
    </Style>

    <!-- WinUI 3 ProgressBar 样式 -->
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- WinUI 3 滚动条 -->
    <Style Selector="ScrollBar">
        <Setter Property="Width" Value="8" />
    </Style>

    <Style Selector="ScrollBar Thumb">
        <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="MinHeight" Value="4" />
    </Style>

    <Style Selector="ScrollBar Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>

    <!-- WinUI 3 SettingsCard 面板（半透明，让 Mica/Blur 材质穿透） -->
    <Style Selector="Border.settingsCard">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- WinUI 3 分组面板（半透明，无边框背景色） -->
    <Style Selector="Border.groupCard">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- WinUI 3 Section Title -->
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- WinUI 3 Label -->
    <Style Selector="TextBlock.label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- WinUI 3 Hint/辅助文本 -->
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- WinUI 3 Accent 文本 -->
    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- WinUI 3 Mono 文本框 -->
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="Cascadia Code, Cascadia Mono, Consolas, 'Courier New'" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- WinUI 3 Separator -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- 全局字体：所有窗口继承 DefaultFont -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFont}" />
    </Style>

    <!-- 标题栏区域 -->
    <Style Selector="Border.titleBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- 窗口控制按钮（最小化/最大化/关闭） -->
    <Style Selector="Button.captionBtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.captionBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.captionBtn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 关闭按钮悬停红色 -->
    <Style Selector="Button.captionBtn.closeBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E81123" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.captionBtn.closeBtn:pointerover TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.captionBtn.closeBtn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#BF0F1E" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Status bar text -->
    <Style Selector="TextBlock.statusText">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</Styles>
