<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rtx-encode-toolkit.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.0.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- 内置第三方工具（scripts/Download-Tools.ps1 生成，目录不存在时 glob 为空不报错） -->
    <None Include="tools\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <!-- 编译期硬检查：内置第三方工具必须存在（应用只使用随包二进制，缺失则中止编译） -->
  <Target Name="CheckBundledTools" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('tools\NVEncC64.exe')"
           Text="缺少内置工具 tools\NVEncC64.exe。请先运行 ./scripts/Download-Tools.ps1" />
    <Error Condition="!Exists('tools\ffmpeg.exe')"
           Text="缺少内置工具 tools\ffmpeg.exe。请先运行 ./scripts/Download-Tools.ps1" />
    <Error Condition="!Exists('tools\ffprobe.exe')"
           Text="缺少内置工具 tools\ffprobe.exe。请先运行 ./scripts/Download-Tools.ps1" />
  </Target>
</Project>
