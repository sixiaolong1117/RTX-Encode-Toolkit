<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:RTX_Encode_Toolkit.Services"
        Width="480"
        MinWidth="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        x:Class="RTX_Encode_Toolkit.Views.MissingToolsWindow"
        Icon="/Assets/rtx-encode-toolkit.ico"
        Title="{services:Localization Key=MissingToolsTitle}"
        Background="Transparent"
        TransparencyLevelHint="Mica,Blur">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid Margin="24"
          RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="14">
        <TextBlock Text="{services:Localization Key=MissingToolsHeader}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   Text="{services:Localization Key=MissingToolsMessage}"
                   Classes="statusText"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <TextBlock x:Name="MissingToolsTextBlock"
                       FontFamily="Cascadia Code, Cascadia Mono, Consolas, 'Courier New'"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="{services:Localization Key=Close}"
                    Click="Close_Click"
                    MinWidth="88" />
            <Button Content="{services:Localization Key=Settings}"
                    Click="OpenSettings_Click"
                    Classes="accent"
                    MinWidth="88" />
        </StackPanel>
    </Grid>
</Window>
