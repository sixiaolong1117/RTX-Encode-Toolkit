<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RTX_Encode_Toolkit.ViewModels"
        xmlns:services="using:RTX_Encode_Toolkit.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="580"
        d:DesignHeight="480"
        Width="580"
        Height="500"
        MinWidth="460"
        MinHeight="400"
        x:Class="RTX_Encode_Toolkit.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        WindowStartupLocation="CenterOwner"
        Title="{services:Localization Key=SettingsTitle}"
        Background="Transparent"
        TransparencyLevelHint="Mica,Blur">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">

        <!-- ========== WinUI 3 风格标题栏 ========== -->
        <Border Classes="titleBar" Padding="16,0" Height="44">
            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <TextBlock Text="{services:Localization Key=SettingsTitle}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text=""
                           Classes="statusText"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ========== 设置内容区域 ========== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,14,20,0">
            <StackPanel Spacing="16">

                <!-- ===== 语言设置区域 ===== -->
                <Border Classes="settingsCard">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{services:Localization Key=LanguageSettings}" Classes="sectionTitle"/>

                        <Grid ColumnDefinitions="80,*" RowSpacing="10">
                            <TextBlock Text="{services:Localization Key=Language}" Classes="label"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      MinWidth="200"
                                      HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ========== 底部按钮区域 ========== -->
        <Border Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{services:Localization Key=Close}"
                        Click="Close_Click"
                        MinWidth="80" MinHeight="34"/>
                <Button Content="{services:Localization Key=Apply}"
                        Command="{Binding ApplyCommand}"
                        MinWidth="80" MinHeight="34"/>
                <Button Content="{services:Localization Key=Save}"
                        Command="{Binding SaveCommand}"
                        Classes="accent"
                        MinWidth="80" MinHeight="34"
                        IsDefault="True"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
