<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RTX_Encode_Toolkit.ViewModels"
        xmlns:services="using:RTX_Encode_Toolkit.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        x:Class="RTX_Encode_Toolkit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/rtx-encode-toolkit.ico"
        Title="{services:Localization Key=WindowTitle}"
        Background="Transparent"
        TransparencyLevelHint="Mica,Blur">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- 主窗口背景使用 Mica Alt 材质 -->
        <Style Selector="Window">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="48,Auto,*" Margin="0">

        <!-- ========== WinUI 3 风格标题栏 ========== -->
        <Border Classes="titleBar">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="RTX Encode Toolkit"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               Classes="statusText"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HasStatusText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Button Content="{services:Localization Key=AddTask}"
                            Click="OpenAddTask_Click"
                            Classes="accent"
                            MinWidth="100" />
                    <Button Content="{services:Localization Key=CancelAll}"
                            Command="{Binding CancelAllCommand}" />
                    <Button Content="{services:Localization Key=Settings}"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Content="{services:Localization Key=About}"
                            Command="{Binding OpenAboutCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 进度条 ========== -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="{Binding IsBusy}"
                     Height="3"
                     IsVisible="{Binding IsBusy}" />

        <!-- ========== 主内容区域 ========== -->
        <Grid Grid.Row="2" RowDefinitions="*,*" Margin="16,12,16,16" RowSpacing="12">

            <!-- 任务队列列表 -->
            <Border Grid.Row="0" Classes="settingsCard" Padding="0">
                    <Grid RowDefinitions="Auto,*" Margin="16">
                        <TextBlock Text="{services:Localization Key=TaskQueue}" Classes="sectionTitle" Margin="0,0,0,8"/>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Queue.Tasks}"
                                 SelectedItem="{Binding Queue.SelectedTask, Mode=TwoWay}"
                                 SelectionMode="Single"

                                 Margin="-16,0"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:EncodeTaskViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,6" ColumnSpacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Classes="statusText"/>
                                            <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding ProgressPercentValue}"
                                                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                         IsVisible="{Binding IsActive}"
                                                         Height="4"
                                                         Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding ProgressText}"
                                                       IsVisible="{Binding HasProgressText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{services:Localization Key=Cancel}"
                                                Command="{Binding CancelCommand}"
                                                IsVisible="{Binding CanCancel}"
                                                MinWidth="60" MinHeight="28" FontSize="12"/>
                                        <Button Grid.Column="2"
                                                Content="{services:Localization Key=Remove}"
                                                Command="{Binding RemoveCommand}"
                                                IsVisible="{Binding CanRemove}"
                                                MinWidth="60" MinHeight="28" FontSize="12"/>
                                        <Button Grid.Column="3"
                                                Content="{services:Localization Key=OpenFolder}"
                                                Command="{Binding OpenOutputCommand}"
                                                IsVisible="{Binding CanOpenFolder}"
                                                MinWidth="28" MinHeight="28" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
            </Border>

            <!-- 日志区域（最后一个选中任务的日志） -->
            <Border Grid.Row="1" Classes="settingsCard" Padding="0">
                    <Grid RowDefinitions="Auto,*" Margin="16">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Text="{services:Localization Key=Log}" Classes="sectionTitle" Margin="0"/>
                            <CheckBox x:Name="FollowLogCheckBox"
                                      Grid.Column="1"
                                      Content="{services:Localization Key=FollowLog}"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      FontSize="13"/>
                        </Grid>
                        <ScrollViewer x:Name="LogScrollViewer"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="-16,0"
                                      Padding="16,0">
                            <TextBox x:Name="LogTextBox"
                                      Classes="mono"
                                      Text="{Binding Queue.SelectedTask.LogText, FallbackValue=''}"
                                      IsReadOnly="True"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap"
                                      HorizontalAlignment="Stretch"
                                      MinWidth="0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      TextChanged="LogTextBox_TextChanged"/>
                        </ScrollViewer>
                    </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
