<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RTX_Encode_Toolkit.ViewModels"
        xmlns:services="using:RTX_Encode_Toolkit.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        x:Class="RTX_Encode_Toolkit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{services:Localization Key=WindowTitle}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Margin="18" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel>
                <TextBlock Text="RTX Encode Toolkit" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusText}" Opacity="0.72" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{services:Localization Key=Settings}" Command="{Binding OpenSettingsCommand}"/>
                <Button Content="{services:Localization Key=ClearLog}" Command="{Binding ClearLogCommand}"/>
                <Button Content="{services:Localization Key=Cancel}" Command="{Binding CancelEncodeCommand}"/>
                <Button Content="{services:Localization Key=StartEncode}" Command="{Binding StartEncodeCommand}" Classes="accent"/>
            </StackPanel>
        </Grid>


        <Grid Grid.Row="1" ColumnDefinitions="430,*" ColumnSpacing="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Classes="panel">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{services:Localization Key=FileSection}" Classes="sectionTitle"/>

                            <Grid ColumnDefinitions="96,*,42" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <TextBlock Text="{services:Localization Key=InputVideo}" Classes="label"/>
                                <TextBox Grid.Column="1" Text="{Binding InputPath}" PlaceholderText="{services:Localization Key=InputPlaceholder}"/>
                                <Button Grid.Column="2" Content="{services:Localization Key=Browse}" Click="BrowseInput_Click"/>

                                <TextBlock Grid.Row="1" Text="{services:Localization Key=OutputDirectory}" Classes="label"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputDirectory}" PlaceholderText="{services:Localization Key=OutputPlaceholder}"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="{services:Localization Key=Browse}" Click="BrowseOutput_Click"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <Border Classes="panel">
                        <StackPanel Spacing="10">
                            <CheckBox Content="{services:Localization Key=VsrSection}" IsChecked="{Binding EnableVsr}" FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Text="{services:Localization Key=AutoLongEdge}" Classes="label"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding AutoVsrResolution}"/>

                                <TextBlock Grid.Row="1" Text="{services:Localization Key=LongEdgePixels}" Classes="label"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="2" Maximum="8192" Increment="2" Value="{Binding VsrLongEdge}"/>

                                <TextBlock Grid.Row="2" Text="{services:Localization Key=FixedResolution}" Classes="label"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VsrResolution}"/>

                                <TextBlock Grid.Row="3" Text="{services:Localization Key=VsrQuality}" Classes="label"/>
                                <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="4" Increment="1" Value="{Binding VsrQuality}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel">
                        <StackPanel Spacing="10">
                            <CheckBox Content="{services:Localization Key=HdrSection}" IsChecked="{Binding EnableHdr}" FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Text="{services:Localization Key=Contrast}" Classes="label"/>
                                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="200" Increment="1" Value="{Binding HdrContrast}"/>

                                <TextBlock Grid.Row="1" Text="{services:Localization Key=Saturation}" Classes="label"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="200" Increment="1" Value="{Binding HdrSaturation}"/>

                                <TextBlock Grid.Row="2" Text="{services:Localization Key=MiddleGray}" Classes="label"/>
                                <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Increment="1" Value="{Binding HdrMiddleGray}"/>

                                <TextBlock Grid.Row="3" Text="{services:Localization Key=MaxLuminance}" Classes="label"/>
                                <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="100" Maximum="4000" Increment="50" Value="{Binding HdrMaxLuminance}"/>

                                <TextBlock Grid.Row="4" Text="{services:Localization Key=MaxCLL}" Classes="label"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding HdrMaxCll}"/>

                                <TextBlock Grid.Row="5" Text="{services:Localization Key=MasterDisplay}" Classes="label"/>
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding HdrMasterDisplay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel">
                        <StackPanel Spacing="10">
                            <CheckBox Content="{services:Localization Key=FrucSection}" IsChecked="{Binding EnableFrameInterpolation}" FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Text="{services:Localization Key=TargetFps}" Classes="label"/>
                                <NumericUpDown Grid.Column="1" Minimum="1" Maximum="240" Increment="1" Value="{Binding TargetFps}"/>

                                <TextBlock Grid.Row="1" Text="{services:Localization Key=SkipHighFps}" Classes="label"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding SkipFrucWhenSourceFpsIsHigh}"/>

                                <TextBlock Grid.Row="2" Text="{services:Localization Key=CfrPreprocess}" Classes="label"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding NormalizeModes}" SelectedItem="{Binding FrucNormalizeMode}"/>

                                <TextBlock Grid.Row="3" Text="{services:Localization Key=CfrFps}" Classes="label"/>
                                <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="240" Increment="0.001" Value="{Binding FrucNormalizeFps}"/>

                                <TextBlock Grid.Row="4" Text="{services:Localization Key=PreprocessCrf}" Classes="label"/>
                                <NumericUpDown Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="51" Increment="1" Value="{Binding FrucNormalizeCrf}"/>

                                <TextBlock Grid.Row="5" Text="{services:Localization Key=PreprocessPreset}" Classes="label"/>
                                <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding NormalizePresets}" SelectedItem="{Binding FrucNormalizePreset}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{services:Localization Key=EncodeSection}" Classes="sectionTitle"/>

                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Text="{services:Localization Key=VideoCodec}" Classes="label"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding VideoCodecs}" SelectedItem="{Binding VideoCodec}"/>

                                <TextBlock Grid.Row="1" Text="{services:Localization Key=Qvbr}" Classes="label"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="51" Increment="1" Value="{Binding Qvbr}"/>

                                <TextBlock Grid.Row="2" Text="{services:Localization Key=Preset}" Classes="label"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding NvencPresets}" SelectedItem="{Binding NvencPreset}"/>

                                <TextBlock Grid.Row="3" Text="{services:Localization Key=BFrames}" Classes="label"/>
                                <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="8" Increment="1" Value="{Binding BFrames}"/>

                                <TextBlock Grid.Row="4" Text="{services:Localization Key=TemporalAq}" Classes="label"/>
                                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding TemporalAq}"/>

                                <TextBlock Grid.Row="5" Text="{services:Localization Key=Deinterlace}" Classes="label"/>
                                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding Deinterlace}"/>

                                <TextBlock Grid.Row="6" Text="{services:Localization Key=Avsync}" Classes="label"/>
                                <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding AvsyncModes}" SelectedItem="{Binding Avsync}"/>
                            </Grid>


                            <CheckBox Content="{services:Localization Key=KeepTempFiles}" IsChecked="{Binding KeepTemporaryFiles}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <Border Classes="panel">
                    <StackPanel>
                        <TextBlock Text="{services:Localization Key=CommandPreview}" Classes="sectionTitle"/>
                        <TextBox Classes="mono"
                                 Text="{Binding CommandPreview}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="150"
                                 MaxHeight="230"/>
                    </StackPanel>
                </Border>

                <ProgressBar Grid.Row="1" IsIndeterminate="{Binding IsBusy}" Height="4"/>

                <Border Grid.Row="2" Classes="panel">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Text="{services:Localization Key=Log}" Classes="sectionTitle" Margin="0"/>
                            <CheckBox x:Name="FollowLogCheckBox"
                                      Grid.Column="1"
                                      Content="{services:Localization Key=FollowLog}"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer x:Name="LogScrollViewer"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="LogTextBox"
                                     Classes="mono"
                                     Text="{Binding LogText}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     TextChanged="LogTextBox_TextChanged"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="3" Text="{Binding LastOutputPath}" Opacity="0.72" TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
